# =========================================================
# Environment Configuration Template
# =========================================================
# Salin file ini menjadi .env lalu isi dengan API key Anda:
#   copy .env.example .env      (Windows CMD)
#   cp .env.example .env        (PowerShell / Bash)
#
# JANGAN pernah meng-commit file .env yang berisi key asli!
# =========================================================

# Google Gemini API Key (dipakai oleh ChatGoogleGenerativeAI LangChain)
GEMINI_API_KEY=your_gemini_api_key_here

# Alias resmi yang dibaca LangChain Google GenAI (sama dengan Gemini API Key)
GOOGLE_API_KEY=your_gemini_api_key_here
